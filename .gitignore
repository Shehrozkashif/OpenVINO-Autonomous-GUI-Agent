# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Virtual environment ──────────────────────────────────────────────────────
venv/
env/
.venv/

# ── Model files (large — never commit) ──────────────────────────────────────
# OVMS model repository: IR weights, tokenizers, generated config
models/*
!models/.gitkeep

# ── OVMS binary (downloaded by start.py on first run, not part of source) ───
ovms/
ovms.zip
ovms_windows_*.zip
ovms_windows_*.zip.part

# ── OVMS export tool (downloaded by start.py on first run) ──────────────────
tools/ovms/

# ── Generated OVMS launchers (Windows) ──────────────────────────────────────
_run_ovms.bat
_test_ovms.bat

# ── Runtime artifacts ────────────────────────────────────────────────────────
*.log
logs/
@AutomationLog.txt
*.db
# task history database written by core/history.py
data/

# ── Test / lint cache ────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Scratch models + logs from tools/test_qwen3vl.py (gigabytes, throwaway)
tools/qwen3vl_probe/
